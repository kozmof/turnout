{
  "compilerOptions": {
    "target": "ES2022",
    // Exactly what `target: ES2022` supplies on its own (lib.es2022.full), plus
    // ESNext.Disposable. Runner and PreparedModel declare `[Symbol.dispose]`, which
    // lives in that lib; Node has had the symbol since 20.11, well under this
    // package's engines floor. The rest are listed only because naming `lib` at all
    // replaces the implicit set, and dropping DOM takes WebAssembly with it.
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "ScriptHost",
      "WebWorker.ImportScripts",
      "ESNext.Disposable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Resolve the `turnout-runtime` monorepo package to its TypeScript source, matching
    // the aliases in vitest.config.ts, so type checking works without a prior
    // `pnpm build`. tsconfig.build.json deliberately omits these: the published
    // build resolves through the package exports to dist.
    "paths": {
      "turnout-runtime": ["../runtime/src/index.ts"],
      "turnout-runtime/zig-runtime": ["../runtime/src/zig-runtime/index.ts"]
    },
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  }
}
