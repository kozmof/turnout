{
  "name": "turnout-scene-runner",
  "version": "0.0.0",
  "private": true,
  "files": ["dist"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/server/index.js",
      "types": "./dist/server/index.d.ts"
    },
    "./zig-runtime/turnout-runtime.wasm": "./dist/zig-runtime/turnout-runtime.wasm"
  },
  "scripts": {
    "build": "pnpm run build:wasm && tsc --project tsconfig.build.json && node ../../../scripts/package-zig-wasm.mjs",
    "build:wasm": "zig build --build-file ../../zig/build.zig wasm",
    "gen:fn-map": "node --experimental-strip-types ../../../scripts/gen-fn-map.ts",
    "lint": "oxlint -c ../../../.oxlintrc.json src/ tests/",
    "fmt": "oxfmt",
    "test": "vitest --run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "runtime": "file:../runtime"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.0",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22 <26"
  }
}
